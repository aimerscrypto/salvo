/* =====================================================================
   SALVO UI - warm, chunky, readable. Flat colors, no neon/glow.
   ===================================================================== */
:root {
    --c-ink: rgb(17, 22, 33);
    --c-panel: rgba(24, 31, 46, 0.92);
    --c-panel-2: rgba(36, 45, 64, 0.96);
    --c-panel-3: rgba(52, 63, 86, 1);
    --c-line: rgba(255, 255, 255, 0.08);
    --c-accent: rgb(242, 179, 61);
    --c-accent-dk: rgb(196, 138, 34);
    --c-coral: rgb(232, 115, 90);
    --c-coral-dk: rgb(186, 78, 58);
    --c-teal: rgb(54, 168, 156);
    --c-teal-dk: rgb(34, 120, 112);
    --c-text: rgb(246, 241, 232);
    --c-muted: rgb(166, 176, 196);
    --c-good: rgb(126, 201, 108);
    --c-bad: rgb(226, 97, 79);
    --c-red: rgb(224, 97, 79);
    --c-blue: rgb(74, 143, 214);



    -unity-font-definition: url("/Assets/_Salvo/Fonts/Rubik-Bold.ttf");
    color: var(--c-text);
    font-size: 18px;
}

.root { flex-grow: 1; }
.screen { position: absolute; left: 0; top: 0; right: 0; bottom: 0; display: none; }
.screen.shown { display: flex; }
.fill { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.row { flex-direction: row; align-items: center; }
.col { flex-direction: column; }
.grow { flex-grow: 1; }
.hidden { display: none; }
.muted { color: var(--c-muted); }
.center { align-items: center; justify-content: center; }

/* ---------- typography ---------- */
.title-xl { -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf"); font-size: 132px; color: var(--c-text); text-shadow: 0 6px 0 rgba(0,0,0,0.35); letter-spacing: 4px; -unity-text-align: middle-left; margin: 0; padding: 0; }
.title-l { -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf"); font-size: 64px; text-shadow: 0 4px 0 rgba(0,0,0,0.35); margin: 0; }
.title-m { -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf"); font-size: 36px; letter-spacing: 1px; margin: 0; }
.title-s { -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf"); font-size: 24px; letter-spacing: 1px; margin: 0; }
.label { -unity-font-definition: url("/Assets/_Salvo/Fonts/Rubik-Medium.ttf"); font-size: 16px; color: var(--c-muted); letter-spacing: 1px; }
.num { -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf"); }

/* ---------- panels ---------- */
.panel { background-color: var(--c-panel); border-radius: 14px; border-width: 0; border-bottom-width: 5px; border-color: rgba(0,0,0,0.35); padding: 22px; }
.panel-2 { background-color: var(--c-panel-2); border-radius: 12px; padding: 14px; border-bottom-width: 4px; border-color: rgba(0,0,0,0.3); }
.scrim { background-color: rgba(10, 13, 20, 0.55); }
.header-band { flex-direction: row; align-items: center; margin-bottom: 18px; }
.header-band .title-l { flex-grow: 1; }

/* ---------- buttons ---------- */
.btn {
    -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf");
    font-size: 26px; letter-spacing: 1px;
    color: var(--c-ink);
    background-color: var(--c-accent);
    border-radius: 10px; border-width: 0; border-bottom-width: 6px; border-color: var(--c-accent-dk);
    padding: 10px 26px 8px 26px; margin: 6px 0;
    -unity-text-align: middle-center;
    transition-property: translate, background-color, scale;
    transition-duration: 0.08s, 0.12s, 0.12s;
}
.btn:hover { translate: 0 -2px; background-color: rgb(250, 196, 86); }
.btn:active { translate: 0 3px; border-bottom-width: 3px; }
.btn:focus { border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-left-color: rgb(255,255,255); border-right-color: rgb(255,255,255); border-top-color: rgb(255,255,255); }
.menu-btn:focus { color: var(--c-accent); translate: 8px 0; }
.btn:disabled { opacity: 0.45; }
.btn.secondary { background-color: var(--c-panel-3); color: var(--c-text); border-color: rgba(0,0,0,0.4); }
.btn.secondary:hover { background-color: rgb(66, 79, 106); }
.btn.coral { background-color: var(--c-coral); border-color: var(--c-coral-dk); color: var(--c-text); }
.btn.coral:hover { background-color: rgb(242, 133, 108); }
.btn.teal { background-color: var(--c-teal); border-color: var(--c-teal-dk); color: var(--c-text); }
.btn.teal:hover { background-color: rgb(68, 186, 173); }
.btn.small { font-size: 18px; padding: 6px 14px 4px 14px; border-bottom-width: 4px; }
.btn.icon { width: 44px; height: 44px; padding: 0; font-size: 24px; }

.menu-btn {
    -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf");
    font-size: 40px; letter-spacing: 2px;
    color: var(--c-text); background-color: rgba(0,0,0,0);
    border-width: 0; border-left-width: 0; border-color: var(--c-accent);
    padding: 4px 0 4px 0; margin: 2px 0;
    -unity-text-align: middle-left;
    text-shadow: 0 3px 0 rgba(0,0,0,0.4);
    transition-property: translate, color, border-left-width, padding-left;
    transition-duration: 0.12s;
}
.menu-btn:hover { color: var(--c-accent); translate: 8px 0; }
.menu-btn.primary { font-size: 60px; color: var(--c-accent); }
.menu-btn.primary:hover { color: rgb(255, 210, 110); }

/* ---------- main menu ---------- */
#main-menu { flex-direction: row; }
.menu-gradient { position: absolute; left: 0; top: 0; bottom: 0; width: 60%; background-image: none; background-color: rgba(10, 14, 24, 0.0); }
.menu-left { width: 640px; padding: 60px 0 60px 84px; justify-content: center; background-color: rgba(10, 14, 24, 0.42); }
.logo-sub { -unity-font-definition: url("/Assets/_Salvo/Fonts/Rubik-Medium.ttf"); font-size: 20px; color: var(--c-accent); letter-spacing: 8px; margin: -12px 0 34px 6px; }
.topbar { position: absolute; top: 26px; right: 30px; flex-direction: row; align-items: center; }
.chip { flex-direction: row; align-items: center; background-color: var(--c-panel); border-radius: 30px; padding: 6px 18px 6px 8px; margin-left: 12px; border-bottom-width: 4px; border-color: rgba(0,0,0,0.35); }
.chip-badge { width: 42px; height: 42px; border-radius: 21px; background-color: var(--c-accent); color: var(--c-ink); -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf"); font-size: 22px; -unity-text-align: middle-center; margin-right: 10px; }
.coin-dot { width: 26px; height: 26px; border-radius: 13px; background-color: var(--c-accent); border-width: 3px; border-color: var(--c-accent-dk); margin-right: 8px; }
.xpbar { width: 160px; height: 10px; border-radius: 5px; background-color: rgba(255,255,255,0.12); margin-top: 4px; overflow: hidden; }
.xpfill { height: 100%; width: 40%; background-color: var(--c-accent); border-radius: 5px; }
.bottom-right { position: absolute; right: 30px; bottom: 26px; align-items: flex-end; }
.version { -unity-font-definition: url("/Assets/_Salvo/Fonts/Rubik-Medium.ttf"); font-size: 14px; color: rgba(255,255,255,0.45); margin-top: 8px; }

/* ---------- generic menu page ---------- */
.page { padding: 50px 70px; }
.page-body { flex-direction: row; flex-grow: 1; }
.card {
    background-color: var(--c-panel-2); border-radius: 12px; padding: 14px; margin: 6px;
    border-width: 3px; border-bottom-width: 6px; border-color: rgba(0,0,0,0.3);
    transition-property: translate, border-color, background-color; transition-duration: 0.1s;
}
.card:hover { translate: 0 -3px; border-color: rgba(242,179,61,0.55); }
.card.selected { border-color: var(--c-accent); background-color: rgb(58, 68, 92); }
.card.locked { opacity: 0.6; }
.card-title { -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf"); font-size: 26px; }
.card-sub { -unity-font-definition: url("/Assets/_Salvo/Fonts/Rubik-Medium.ttf"); font-size: 14px; color: var(--c-muted); }
.price { flex-direction: row; align-items: center; -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf"); font-size: 20px; color: var(--c-accent); }
.tag { -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf"); font-size: 14px; color: var(--c-ink); background-color: var(--c-teal); border-radius: 6px; padding: 2px 8px; margin-left: 6px; }
.tag.equipped { background-color: var(--c-accent); }
.tag.rare { background-color: rgb(92, 160, 230); }
.tag.epic { background-color: rgb(170, 120, 230); }
.tag.legendary { background-color: rgb(240, 170, 60); }
.swatch { width: 54px; height: 54px; border-radius: 10px; margin: 5px; border-width: 4px; border-color: rgba(0,0,0,0.3); }
.swatch.selected { border-color: var(--c-text); }
.icon-img { width: 210px; height: 74px; -unity-background-scale-mode: scale-to-fit; }
.statrow { flex-direction: row; align-items: center; margin: 4px 0; }
.statrow .label { width: 120px; }
.statbar { flex-grow: 1; height: 10px; border-radius: 5px; background-color: rgba(255,255,255,0.1); }
.statfill { height: 100%; border-radius: 5px; background-color: var(--c-accent); }
.section-title { -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf"); font-size: 22px; color: var(--c-accent); margin: 14px 6px 4px 6px; letter-spacing: 1px; }
.tabs { flex-direction: row; margin-bottom: 12px; }
.tab { -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf"); font-size: 22px; color: var(--c-muted); background-color: rgba(0,0,0,0); border-width: 0; border-bottom-width: 4px; border-color: rgba(0,0,0,0); padding: 6px 18px; margin-right: 6px; }
.tab:hover { color: var(--c-text); }
.tab.active { color: var(--c-text); border-color: var(--c-accent); }

/* ---------- form controls ---------- */
.setting-row { flex-direction: row; align-items: center; justify-content: space-between; padding: 10px 14px; border-radius: 8px; margin: 2px 0; background-color: rgba(255,255,255,0.03); }
.setting-row:hover { background-color: rgba(255,255,255,0.07); }
.setting-name { -unity-font-definition: url("/Assets/_Salvo/Fonts/Rubik-Medium.ttf"); font-size: 18px; }
.cycler { flex-direction: row; align-items: center; width: 320px; justify-content: space-between; }
.cycler-value { -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf"); font-size: 20px; -unity-text-align: middle-center; flex-grow: 1; }
.arrow { -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf"); font-size: 22px; width: 40px; height: 36px; padding: 0; border-radius: 8px; border-width: 0; border-bottom-width: 3px; border-color: rgba(0,0,0,0.4); background-color: var(--c-panel-3); color: var(--c-text); }
.arrow:hover { background-color: var(--c-accent); color: var(--c-ink); }
.textfield { width: 320px; }
.textfield > .unity-base-text-field__input { background-color: rgba(0,0,0,0.35); border-radius: 8px; border-width: 2px; border-color: rgba(255,255,255,0.12); color: var(--c-text); -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf"); font-size: 22px; padding: 6px 10px; }
.textfield:focus > .unity-base-text-field__input { border-color: var(--c-accent); }
.slider-wrap { flex-direction: row; align-items: center; width: 320px; }
.slider-wrap .unity-slider { flex-grow: 1; margin: 0 10px 0 0; }
.slider-value { -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf"); font-size: 18px; width: 52px; -unity-text-align: middle-right; }
.unity-base-slider__dragger { background-color: var(--c-accent); border-radius: 9px; width: 18px; height: 18px; margin-top: -8px; border-width: 0; }
.unity-base-slider__tracker { background-color: rgba(255,255,255,0.15); border-radius: 3px; height: 6px; border-width: 0; margin-top: -2px; }
.unity-base-slider--horizontal .unity-base-slider__drag-container { height: 20px; }

/* ---------- connecting / modal / toast ---------- */
.modal { width: 640px; align-items: center; }
.modal-body { -unity-font-definition: url("/Assets/_Salvo/Fonts/Rubik-Medium.ttf"); font-size: 20px; white-space: normal; -unity-text-align: middle-center; margin: 16px 0 22px 0; color: var(--c-text); }
.spinner { width: 54px; height: 54px; border-radius: 27px; border-width: 7px; border-color: rgba(255,255,255,0.15); border-top-color: var(--c-accent); margin-bottom: 18px; }
.toast-layer { position: absolute; top: 90px; left: 0; right: 0; align-items: center; }
.toast { -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf"); font-size: 22px; background-color: var(--c-panel); color: var(--c-text); padding: 10px 22px; border-radius: 10px; margin: 4px; border-bottom-width: 4px; border-color: rgba(0,0,0,0.35); transition-property: opacity, translate; transition-duration: 0.25s; }
.toast.out { opacity: 0; translate: 0 -10px; }

/* ===================================================================== HUD */
#hud { }
.crosshair { position: absolute; left: 50%; top: 50%; width: 0; height: 0; }
.cross-line { position: absolute; background-color: rgb(255,255,255); border-width: 1px; border-color: rgba(0,0,0,0.55); }
.cross-dot { position: absolute; width: 4px; height: 4px; left: -2px; top: -2px; background-color: rgb(255,255,255); border-radius: 2px; border-width: 1px; border-color: rgba(0,0,0,0.5); }
.hitmarker { position: absolute; left: 50%; top: 50%; width: 0; height: 0; opacity: 0; }
.hit-line { position: absolute; width: 3px; height: 12px; background-color: white; border-radius: 1px; }
.hud-bottom-left { position: absolute; left: 36px; bottom: 30px; flex-direction: row; align-items: flex-end; }
.hud-bottom-right { position: absolute; right: 36px; bottom: 30px; align-items: flex-end; }
.health-box { background-color: var(--c-panel); border-radius: 12px; padding: 10px 16px 12px 16px; border-bottom-width: 5px; border-color: rgba(0,0,0,0.35); width: 300px; }
.health-num { -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf"); font-size: 46px; margin: -6px 0 -2px 0; }
.health-bar { height: 14px; border-radius: 7px; background-color: rgba(255,255,255,0.12); overflow: hidden; }
.health-fill { height: 100%; width: 100%; border-radius: 7px; background-color: var(--c-good); transition-property: width; transition-duration: 0.15s; }
.health-ghost { position: absolute; left: 0; top: 0; bottom: 0; width: 100%; background-color: rgba(255,255,255,0.55); border-radius: 7px; }
.ammo-box { background-color: var(--c-panel); border-radius: 12px; padding: 8px 18px 10px 18px; border-bottom-width: 5px; border-color: rgba(0,0,0,0.35); align-items: flex-end; min-width: 220px; }
.ammo-mag { -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf"); font-size: 56px; margin: -8px 0 -6px 0; }
.ammo-res { -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf"); font-size: 26px; color: var(--c-muted); margin-left: 8px; }
.weapon-name { -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf"); font-size: 20px; color: var(--c-accent); letter-spacing: 1px; }
.slots { flex-direction: row; margin-bottom: 8px; }
.slot { -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf"); font-size: 15px; color: var(--c-muted); background-color: rgba(24,31,46,0.75); border-radius: 6px; padding: 3px 10px; margin-left: 6px; }
.slot.active { color: var(--c-ink); background-color: var(--c-accent); }
.top-center { position: absolute; top: 18px; left: 0; right: 0; align-items: center; }
.score-strip { flex-direction: row; align-items: center; }
.score-team { -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf"); font-size: 32px; width: 92px; height: 52px; -unity-text-align: middle-center; border-radius: 10px; border-bottom-width: 5px; border-color: rgba(0,0,0,0.35); color: white; }
.score-team.red { background-color: var(--c-red); }
.score-team.blue { background-color: var(--c-blue); }
.timer { -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf"); font-size: 30px; background-color: var(--c-panel); border-radius: 10px; padding: 6px 18px; margin: 0 10px; border-bottom-width: 5px; border-color: rgba(0,0,0,0.35); min-width: 110px; -unity-text-align: middle-center; }
.ffa-info { -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf"); font-size: 18px; color: var(--c-muted); margin-top: 6px; background-color: rgba(24,31,46,0.75); border-radius: 8px; padding: 3px 12px; }
.killfeed { position: absolute; right: 26px; top: 22px; align-items: flex-end; }
.kf-row { flex-direction: row; align-items: center; background-color: rgba(24,31,46,0.85); border-radius: 8px; padding: 4px 12px; margin-bottom: 5px; transition-property: opacity; transition-duration: 0.4s; }
.kf-row.mine { border-width: 2px; border-color: var(--c-accent); }
.kf-name { -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf"); font-size: 18px; }
.kf-weapon { -unity-font-definition: url("/Assets/_Salvo/Fonts/Rubik-Medium.ttf"); font-size: 14px; color: var(--c-muted); margin: 0 10px; }
.kf-head { -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf"); font-size: 13px; color: var(--c-ink); background-color: var(--c-accent); border-radius: 4px; padding: 1px 5px; margin-right: 8px; }
.kill-banner { position: absolute; left: 0; right: 0; bottom: 210px; align-items: center; transition-property: opacity, scale; transition-duration: 0.18s; }
.kill-banner-text { -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf"); font-size: 34px; color: var(--c-text); text-shadow: 0 3px 0 rgba(0,0,0,0.5); }
.kill-banner-sub { -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf"); font-size: 22px; color: var(--c-accent); text-shadow: 0 2px 0 rgba(0,0,0,0.5); }
.streak { -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf"); font-size: 26px; color: var(--c-coral); text-shadow: 0 3px 0 rgba(0,0,0,0.5); }
.respawn { position: absolute; left: 0; right: 0; top: 30%; align-items: center; }
.respawn-killer { -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf"); font-size: 30px; }
.respawn-timer { -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf"); font-size: 80px; color: var(--c-accent); text-shadow: 0 5px 0 rgba(0,0,0,0.4); }
.scope { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: scale-and-crop; }
.dmg-indicator { position: absolute; left: 50%; top: 50%; width: 0; height: 0; }
.dmg-arc { position: absolute; width: 80px; height: 14px; left: -40px; top: -190px; border-radius: 7px; background-color: rgba(226, 97, 79, 0.9); border-bottom-width: 3px; border-color: rgba(100,20,10,0.6); }
.hit-number { position: absolute; -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf"); font-size: 22px; color: white; text-shadow: 0 2px 0 rgba(0,0,0,0.6); }
.hit-number.head { color: var(--c-accent); font-size: 26px; }
.nameplate { position: absolute; -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf"); font-size: 16px; color: white; text-shadow: 0 2px 0 rgba(0,0,0,0.6); -unity-text-align: middle-center; width: 200px; margin-left: -100px; }
.nameplate-bar { height: 4px; width: 60px; border-radius: 2px; background-color: rgba(0,0,0,0.5); margin-left: 70px; }
.nameplate-fill { height: 100%; border-radius: 2px; background-color: var(--c-good); }
.center-hint { position: absolute; left: 0; right: 0; top: 58%; align-items: center; }
.hint { -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf"); font-size: 20px; color: var(--c-text); background-color: rgba(24,31,46,0.75); border-radius: 8px; padding: 4px 14px; }
.reload-bar { width: 120px; height: 6px; border-radius: 3px; background-color: rgba(0,0,0,0.4); margin-top: 6px; overflow: hidden; }
.reload-fill { height: 100%; background-color: var(--c-accent); }
.fps { position: absolute; left: 10px; top: 8px; -unity-font-definition: url("/Assets/_Salvo/Fonts/Rubik-Medium.ttf"); font-size: 14px; color: rgba(255,255,255,0.7); }
.code-chip { position: absolute; left: 26px; top: 22px; -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf"); font-size: 18px; color: var(--c-muted); background-color: rgba(24,31,46,0.75); border-radius: 8px; padding: 4px 12px; }
.spawn-shield { -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf"); font-size: 16px; color: var(--c-teal); margin-bottom: 6px; }

/* ---------- scoreboard / end ---------- */
.board { width: 1000px; }
.sb-head { flex-direction: row; padding: 6px 14px; }
.sb-head Label { -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf"); font-size: 16px; color: var(--c-muted); }
.sb-row { flex-direction: row; align-items: center; padding: 6px 14px; border-radius: 8px; margin: 2px 0; background-color: rgba(255,255,255,0.04); }
.sb-row.me { background-color: rgba(242,179,61,0.22); }
.sb-row Label { -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf"); font-size: 20px; }
.sb-rank { width: 40px; color: var(--c-muted); }
.sb-name { flex-grow: 1; }
.sb-cell { width: 80px; -unity-text-align: middle-right; }
.sb-team-bar { width: 6px; height: 26px; border-radius: 3px; margin-right: 12px; }
.end-title { -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf"); font-size: 96px; text-shadow: 0 6px 0 rgba(0,0,0,0.35); }
.reward-row { flex-direction: row; justify-content: space-between; padding: 6px 4px; border-bottom-width: 1px; border-color: var(--c-line); }
.reward-row Label { -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf"); font-size: 20px; }
.reward-xp { color: var(--c-teal); width: 90px; -unity-text-align: middle-right; }
.reward-coins { color: var(--c-accent); width: 90px; -unity-text-align: middle-right; }
.levelup { -unity-font-definition: url("/Assets/_Salvo/Fonts/LilitaOne-Regular.ttf"); font-size: 30px; color: var(--c-accent); }
